* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: #f5f7fb;
  color: #222;
  padding: 40px 20px;
}

.container {
  max-width: 720px;
  margin: 0 auto;
  background: #fff;
  padding: 30px;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
}

h1 {
  margin-top: 0;
  font-size: 24px;
}

.desc {
  color: #666;
  font-size: 14px;
  margin-bottom: 24px;
}

.dropzone {
  border: 2px dashed #c7d0e0;
  border-radius: 10px;
  padding: 30px;
  text-align: center;
  background: #fafbff;
  transition: 0.2s;
}

.dropzone.drag {
  border-color: #4f7cff;
  background: #eef3ff;
}

.btn {
  margin-top: 12px;
  padding: 10px 18px;
  border: 1px solid #d0d7e2;
  background: #fff;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
}

.btn:hover {
  background: #f1f4fa;
}

.btn.primary {
  background: #4f7cff;
  color: #fff;
  border-color: #4f7cff;
}

.btn.primary:hover {
  background: #3b66e0;
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.options {
  margin: 20px 0;
  font-size: 14px;
}

.options select {
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid #d0d7e2;
}

.file-list {
  margin-top: 20px;
  font-size: 14px;
}

.file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 12px;
  border: 1px solid #e5e9f2;
  border-radius: 8px;
  margin-bottom: 8px;
  background: #fafbff;
}

.file-item .name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12px;
}

.file-item .state {
  font-size: 12px;
  color: #666;
}

.file-item.success .state {
  color: #2e9e5a;
}

.file-item.error .state {
  color: #d64545;
}

.actions {
  margin-top: 20px;
  display: flex;
  gap: 10px;
}

.status {
  margin-top: 16px;
  font-size: 13px;
  color: #555;
}
